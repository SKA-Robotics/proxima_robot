<?xml version="1.0"?>
<robot name="dynamixel_test_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find proxima_description)/robots/dynamixel_AX-12A.xacro" />
    <xacro:include filename="$(find proxima_description)/robots/dynamixel_MX-106T.xacro" />
    <xacro:include filename="$(find proxima_description)/robots/dynamixel_XM430-W350.xacro" /> 
    
    <xacro:include filename="$(find proxima_description)/robots/dynamixel_test_ros2_control.xacro" />

    <link name="base_link" />

    <xacro:dynamixel_AX-12A name="joint3" parent="base_link" xyz="0 0 0.05" rpy="0 0 0" />

    <xacro:dynamixel_MX-106T name="joint4" parent="joint3_output" xyz="0 0 0.05" rpy="0 0 0" />

    <xacro:dynamixel_MX-106T name="joint5" parent="joint4_output" xyz="0 0 0.05" rpy="0 0 0" />


    <!--USTALIC PORT NAME-->
    <xacro:dynamixel_system_control 
        name="DynamixelTestSystem" 
        port_name="/dev/ttyUSB0"  
        baud_rate="1000000" 
        error_timeout_ms="100" />

</robot>