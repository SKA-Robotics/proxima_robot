<?xml version="1.0"?>
<!--
  Minimalny opis robota do testu połączenia z trzema sterownikami moteus.
  Każdy silnik to osobny przegub obrotowy przymocowany do base_link.
-->
<robot name="proxima_manip" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Argumenty z linii poleceń / launcha -->
  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="can_id_1" default="1"/>
  <xacro:arg name="can_id_2" default="2"/>
  <xacro:arg name="can_id_3" default="3"/>
  <xacro:arg name="effort_max" default="1.0"/>

  <xacro:include filename="$(find proxima_description)/robots/moteus_motor.xacro"/>
  <xacro:include filename="$(find proxima_description)/robots/moteus_test.ros2_control.xacro"/>

  <!-- Bazowa płyta montażowa -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.15 0.01"/>
      </geometry>
      <material name="plate_grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.15 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0019" ixy="0" ixz="0" iyy="0.0133" iyz="0" izz="0.0152"/>
    </inertial>
  </link>

  <!-- Trzy silniki w rzędzie na płycie -->
  <xacro:moteus_motor name="joint1" parent="base_link" xyz="-0.12 0 0.01"/>
  <xacro:moteus_motor name="joint2" parent="base_link" xyz="0.00 0 0.01"/>
  <xacro:moteus_motor name="joint3" parent="base_link" xyz="0.12 0 0.01"/>

  <!-- ros2_control -->
  <xacro:proxima_manip_ros2_control
    name="Proxima_Manip_System"
    use_mock_hardware="$(arg use_mock_hardware)"
    can_id_1="$(arg can_id_1)"
    can_id_2="$(arg can_id_2)"
    can_id_3="$(arg can_id_3)"
    effort_max="$(arg effort_max)"/>

</robot>
