<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- https://github.com/SKA-Robotics/sirius_common/blob/noetic/manip/config/roboszpon_driver.yaml
manip_roboszpon_driver:
  joints:
    joint4:
      node_id: 0
    joint5:
      node_id: 1
    joint6:
      node_id: 2
      -->

    <xacro:arg name="use_mock_hardware" default="true" />

    <xacro:macro name="dynamixel_system_control" params="name port_name baud_rate error_timeout_ms">
        <ros2_control name="${name}" type="system">
            
            <hardware>
                <xacro:if value="$(arg use_mock_hardware)">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                
                <xacro:unless value="$(arg use_mock_hardware)">
                    <param name="port_name">${port_name}</param>
                    <param name="error_timeout_ms">${error_timeout_ms}</param>
                    <plugin>proxima_manip_controller/DynamixelSystem</plugin>
                </xacro:unless>
            </hardware>

            <xacro:dynamixel_ax_12a_joint_interface name="joint4" servo_id="0"/>
            <xacro:dynamixel_mx_106t_joint_interface name="joint5" servo_id="1"/>
            <xacro:dynamixel_mx_106t_joint_interface name="joint6" servo_id="2"/>
            <xacro:dynamixel_xm430-w350_joint_interface name="joint_gripper" servo_id="44"/>
                        
        </ros2_control>
    </xacro:macro>

    <xacro:macro name="dynamixel_ax_12a_joint_interface" params="name servo_id">
        <joint name="${name}">
            <param name="model">ax</param>
            <param name="servo_id">${servo_id}</param>
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="dynamixel_mx_106t_joint_interface" params="name servo_id">
        <joint name="${name}">
            <param name="model">mx</param>
            <param name="servo_id">${servo_id}</param>
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="dynamixel_xm430-w350_joint_interface" params="name servo_id">
        <joint name="${name}">
            <param name="model">xm</param>
            <param name="servo_id">${servo_id}</param>
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
    </xacro:macro>



    
</robot>