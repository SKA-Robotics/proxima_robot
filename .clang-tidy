Checks: >
  -*,
  bugprone-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-lambda-function-name

WarningsAsErrors: '*'

HeaderFilterRegex: '.*/src/repo/.*'

CheckOptions:
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'shared_ptr;SharedPtr;ConstSharedPtr'
