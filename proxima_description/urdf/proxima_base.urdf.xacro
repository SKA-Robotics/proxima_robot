<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="proxima_base">

  <!-- Mesh filenames -->
  <xacro:property name="mesh_platform" value="package://proxima_description/meshes/proxima/platform.stl"/>
  <xacro:property name="mesh_platform_collision" value="package://proxima_description/meshes/proxima/platform_collision.stl"/>


  <xacro:property name="mesh_fork" value="package://proxima_description/meshes/proxima/fork.stl"/>

  <!-- Materials -->

  <material name="proxima_color">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>


  <!-- Base Link -->
  <link name="base_link" />

  <!-- Platform Link -->
  <link name="platform_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_platform}" scale="1 1 1"/>
      </geometry>
      <material name="proxima_color"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_platform_collision}" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="platform_link"/>
    <origin xyz="0 0 0.27" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="prefix:=wheel xyz rpy mirror:=false">
    <link name="${prefix}_fork_link">
      <visual>

        <xacro:if value="${mirror}">
          <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        </xacro:if>
        <xacro:unless value="${mirror}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:unless>

        <geometry>
          <mesh filename="${mesh_fork}" scale="1 1 1"/>
        </geometry>
        <material name="proxima_color"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_fork}" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.12" length="0.12"/>
        </geometry>
        <material name="proxima_color"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.12" length="0.12"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_swerve_joint" type="revolute">
      <parent link="platform_link"/>
      <child link="${prefix}_fork_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
      <limit effort="100" velocity="10" lower="${-pi}" upper="${pi}"/>
    </joint>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_fork_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 -0.175" rpy="-${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

  </xacro:macro>

  <xacro:wheel prefix="front_right" xyz="0.48 -0.345 0.03" rpy="0 0 0" mirror="true"/>
  <xacro:wheel prefix="front_left" xyz="0.48 0.345 0.03" rpy="0 0 0" mirror="false"/>
  <xacro:wheel prefix="back_right" xyz="-0.48 -0.345 0.03" rpy="0 0 0" mirror="true"/>
  <xacro:wheel prefix="back_left" xyz="-0.48 0.345 0.03" rpy="0 0 0" mirror="false"/>

</robot>
