<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!--ZMIEN PARAMETRY-->
    <xacro:macro name="dynamixel_XM430-W350" params="name parent xyz rpy:='0 0 0'">
        
        <xacro:property name="dxl_mass" value="0.0546"/>
        <xacro:property name="dxl_width" value="0.032"/>
        <xacro:property name="dxl_height" value="0.05"/>
        <xacro:property name="dxl_length" value="0.04"/>

        <joint name="${name}_mount" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_housing"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>

        <link name="${name}_housing">
            <visual>
                <material name="grey"/>
                <origin xyz="0 0 ${dxl_length/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${dxl_length} ${dxl_width} ${dxl_height}"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 ${dxl_length/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${dxl_length} ${dxl_width} ${dxl_height}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="${dxl_mass}"/>
                <origin xyz="0 0 ${dxl_length/2}" rpy="0 0 0"/>
                <inertia ixx="${dxl_mass*(dxl_width*dxl_width + dxl_height*dxl_height)/12}"
                         iyy="${dxl_mass*(dxl_length*dxl_length + dxl_height*dxl_height)/12}"
                         izz="${dxl_mass*(dxl_length*dxl_length + dxl_width*dxl_width)/12}"
                         ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>

        <joint name="${name}" type="revolute">
            <parent link="${name}_housing"/>
            <child link="${name}_output"/>
            <origin xyz="0 0 ${dxl_length}" rpy="0 0 0"/>
            <!-- limity do zmienienia -->
            <limit lower="-2.617" upper="2.617" effort="1.5" velocity="6.17"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${name}_output">
            <visual>
                <material name="black"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.005"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.005"/>
                </geometry>
            </collision>
            <inertial>
                <!-- wartosci testowe -->
                <mass value="0.005"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            </inertial>
        </link>

    </xacro:macro>
</robot>